# Copy to .env - never commit .env to GitHub.
# Only VITE_ variables are exposed to the browser. NEVER put secrets here.
VITE_API_URL=https://localhost:4000

# true  = gigs, bookings and transactions use built-in fake data (src/mocks).
# false = they call the real API. Login and register always use the real API.
VITE_USE_MOCKS=true