# Copy to .env - never commit .env to GitHub.
# Only VITE_ variables are exposed to the browser. NEVER put secrets here.
VITE_API_URL=https://localhost:4000

# Set to true to use built-in fake gigs, bookings and payments instead of the
# API (handy for trying the screens without the backend running). Login and
# registration still use the real API. Leave as false for normal use.
VITE_USE_MOCKS=false
