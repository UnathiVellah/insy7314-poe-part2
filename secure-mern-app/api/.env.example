# Copy to .env and fill in real values. Never commit .env to GitHub.

APP_NAME=HustleHub+API
PORT=4000

# Set to "true" to serve over HTTPS using the certs below (required for
# the Part 1 submission/demo). Leave "false" for quick local iteration.
USE_HTTPS=true
SSL_KEY_PATH=./certs/localhost-key.pem
SSL_CERT_PATH=./certs/localhost-cert.pem

# Must match the React frontend's origin (used for CORS + CSP connect-src)
CLIENT_ORIGIN=http://localhost:5173

# JWT signing secret - use a long random string (e.g. openssl rand -hex 64)
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=1h
