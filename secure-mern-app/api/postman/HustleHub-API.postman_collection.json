{
  "info": {
    "_postman_id": "7e2f0a4c-9d1b-4f6a-b3e8-5c1a9f7d2e40",
    "name": "HustleHub API",
    "description": "INSY7314 POE Part 1.\n\nPostman test collection for the HustleHub API.\n\nCovers:\n- Health check\n- User registration (happy path + validation/duplicate/malicious input edge cases)\n- Login (happy path + wrong password/non-existent email/missing fields)\n- JWT-protected /me route (no token, malformed header, invalid token, valid token)\n- Security/negative tests (404 handling, oversized payload rejection)\n\nRun with the \"HustleHub Local\" environment selected, server running on http://localhost:4000.\nRun order matters: Register - Happy Path before Duplicate Email; Login - Happy Path before Me - Valid Token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "1. GET /health",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Body reports OK status', () => {",
                  "    pm.expect(pm.response.json().status).to.eql('OK');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Register",
      "item": [
        {
          "name": "2. Register - Happy Path",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Person Three Tester\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Response does not leak passwordHash', () => {",
                  "    pm.expect(pm.response.text()).to.not.include('passwordHash');",
                  "});",
                  "pm.test('Returns expected user fields', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.data).to.have.property('id');",
                  "    pm.expect(json.data.email).to.eql(pm.environment.get('testEmail').toLowerCase());",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Register - Duplicate Email",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Person Three Tester\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 409', () => pm.response.to.have.status(409));",
                  "pm.test('Error message present', () => {",
                  "    pm.expect(pm.response.json().error).to.eql('User already exists');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Register - Missing Fields",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status is 400', () => pm.response.to.have.status(400));"]
              }
            }
          ]
        },
        {
          "name": "5. Register - Invalid Email Format",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Bad Email Tester\",\n  \"email\": \"not-an-email\",\n  \"password\": \"TestPass123!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status is 400', () => pm.response.to.have.status(400));"]
              }
            }
          ]
        },
        {
          "name": "6. Register - Password Too Short",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Short Pw Tester\",\n  \"email\": \"shortpw@hustlehub.test\",\n  \"password\": \"short1\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status is 400', () => pm.response.to.have.status(400));"]
              }
            }
          ]
        },
        {
          "name": "7. Register - Non-string Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Bad Type Tester\",\n  \"email\": \"badtype@hustlehub.test\",\n  \"password\": 12345678\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status is 400', () => pm.response.to.have.status(400));"]
              }
            }
          ]
        },
        {
          "name": "8. Register - XSS Payload",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"<script>alert(1)</script>\",\n  \"email\": \"xsstest@hustlehub.test\",\n  \"password\": \"TestPass123!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Server does not crash', () => {",
                  "    pm.expect([201, 400]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Login",
      "item": [
        {
          "name": "9. Login - Happy Path",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Token stored', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.data).to.have.property('token');",
                  "    pm.environment.set('token', json.data.token);",
                  "});",
                  "pm.test('Response does not leak passwordHash', () => {",
                  "    pm.expect(pm.response.text()).to.not.include('passwordHash');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "10. Login - Wrong Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"WrongPass999!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('Generic message', () => {",
                  "    pm.expect(pm.response.json().error).to.eql('Invalid email or password');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "11. Login - Non-existent Email",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nobody@hustlehub.test\",\n  \"password\": \"WhateverPass1!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('Same generic message (no user enumeration)', () => {",
                  "    pm.expect(pm.response.json().error).to.eql('Invalid email or password');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "12. Login - Missing Fields",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status is 400', () => pm.response.to.have.status(400));"]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Protected",
      "item": [
        {
          "name": "13. Me - No Token",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status is 401', () => pm.response.to.have.status(401));"]
              }
            }
          ]
        },
        {
          "name": "14. Me - Malformed Header",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Token abc123" }],
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status is 401', () => pm.response.to.have.status(401));"]
              }
            }
          ]
        },
        {
          "name": "15. Me - Invalid/Tampered Token",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer invalid.token.value" }],
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('Generic message', () => {",
                  "    pm.expect(pm.response.json().error).to.eql('Invalid or expired token');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "16. Me - Valid Token",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Profile matches test user', () => {",
                  "    pm.expect(pm.response.json().data.email).to.eql(pm.environment.get('testEmail'));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Security + Negative Tests",
      "item": [
        {
          "name": "17. 404 - Unknown Route",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/auth/nope", "host": ["{{baseUrl}}"], "path": ["api", "auth", "nope"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status is 404', () => pm.response.to.have.status(404));"]
              }
            }
          ]
        },
        {
          "name": "18. Payload Too Large",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"{{bigString}}\",\n  \"email\": \"bigpayload@hustlehub.test\",\n  \"password\": \"TestPass123!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.variables.set('bigString', 'A'.repeat(11000));"]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Oversized payload rejected', () => {",
                  "    pm.expect(pm.response.code).to.be.at.least(400);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
